@model IEnumerable<NsbmLesson12.Models.NsbmCategory>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Danh mục sản phẩm</h1>
            <p class="text-muted mb-0">Quản lý các danh mục quần áo trong hệ thống.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm danh mục
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên danh mục</th>
                            <th>Ngày tạo</th>
                            <th>Số sản phẩm</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    Chưa có danh mục nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold">@item.Nsbmname</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            @item.NsbmCreatedDate.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @(item.NsbmProducts?.Count ?? 0) sản phẩm
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details"
                                               asp-route-nsbmid="@item.NsbmId"
                                               class="btn btn-sm btn-outline-info">
                                                Chi tiết
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-nsbmid="@item.NsbmId"
                                               class="btn btn-sm btn-outline-primary">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-nsbmid="@item.NsbmId"
                                               class="btn btn-sm btn-outline-danger">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
