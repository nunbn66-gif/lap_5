@model NsbmLesson12.Models.NsbmCategory

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-info text-white py-3">
                    <h2 class="h4 mb-0">Chi tiết danh mục</h2>
                </div>

                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Mã danh mục</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.NsbmId</dd>

                        <dt class="col-sm-4 text-muted">Tên danh mục</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Nsbmname</dd>

                        <dt class="col-sm-4 text-muted">Ngày tạo</dt>
                        <dd class="col-sm-8">
                            @Model.NsbmCreatedDate.ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-4 text-muted">Số sản phẩm</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">
                                @(Model.NsbmProducts?.Count ?? 0) sản phẩm
                            </span>
                        </dd>
                    </dl>
                </div>

                <div class="card-footer bg-white border-0 px-4 pb-4">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit"
                           asp-route-nsbmid="@Model.NsbmId"
                           class="btn btn-primary">
                            Sửa
                        </a>
                        <a asp-action="Delete"
                           asp-route-nsbmid="@Model.NsbmId"
                           class="btn btn-outline-danger">
                            Xóa
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
