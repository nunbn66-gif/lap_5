@model NsbmLesson12.Models.NsbmCategory

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning py-3">
                    <h2 class="h4 mb-0">Sửa danh mục</h2>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="NsbmId" />

                        <div class="mb-3">
                            <label asp-for="Nsbmname" class="form-label fw-semibold">Tên danh mục</label>
                            <input asp-for="Nsbmname" class="form-control" />
                            <span asp-validation-for="Nsbmname" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NsbmCreatedDate" class="form-label fw-semibold">Ngày tạo</label>
                            <input asp-for="NsbmCreatedDate"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="NsbmCreatedDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-warning">
                                Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
