@model List<NsbmLesson12.Models.NsbmProduct>
<div class="container">
    <h2>Products</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.NsbmName</td>
                    <td>@product.NsbmPrice</td>
                    <td>@product.NsbmDescription</td>
                </tr>
            }
        </tbody>
    </table>
</div>