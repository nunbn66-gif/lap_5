@model NsbmLesson12.Models.NsbmProduct

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h1 class="h4 mb-0">Xóa sản phẩm</h1>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa sản phẩm này không?
                    </div>

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="bg-light rounded-3 p-4 h-100">
                                <div class="small text-muted mb-2">Hình ảnh / đường dẫn</div>
                                <div class="fw-semibold text-break">
                                    @(string.IsNullOrWhiteSpace(Model.NsbmImage) ? "Chưa có" : Model.NsbmImage)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <h2 class="h4 fw-bold mb-3">@Model.NsbmName</h2>

                            <dl class="row mb-0">
                                <dt class="col-sm-5 text-muted">Mã sản phẩm</dt>
                                <dd class="col-sm-7 fw-semibold">@Model.NsbmId</dd>

                                <dt class="col-sm-5 text-muted">Giá sản phẩm</dt>
                                <dd class="col-sm-7">@Model.NsbmPrice.ToString("N0") VNĐ</dd>

                                <dt class="col-sm-5 text-muted">Giá bán</dt>
                                <dd class="col-sm-7 text-danger fw-semibold">
                                    @Model.NsbmsalePrice.ToString("N0") VNĐ
                                </dd>

                                <dt class="col-sm-5 text-muted">Trạng thái</dt>
                                <dd class="col-sm-7">
                                    <span class="badge bg-secondary">@Model.NsbmStatus</span>
                                </dd>

                                <dt class="col-sm-5 text-muted">Danh mục</dt>
                                <dd class="col-sm-7">#@Model.NsbmCategoryId</dd>

                                <dt class="col-sm-5 text-muted">Ngày tạo</dt>
                                <dd class="col-sm-7">
                                    @Model.NsbmCreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </dd>
                            </dl>
                        </div>

                        <div class="col-12">
                            <hr />
                            <h3 class="h6 fw-semibold">Mô tả</h3>
                            <div class="bg-light rounded-3 p-3">
                                @(string.IsNullOrWhiteSpace(Model.Descriptions)
                                    ? "Chưa có mô tả."
                                    : Model.Descriptions)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-0 px-4 pb-4">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="NsbmId" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                Xác nhận xóa
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
