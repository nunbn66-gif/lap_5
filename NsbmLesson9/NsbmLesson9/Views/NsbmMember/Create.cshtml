@model NsbmLesson9.Models.DataViewModels.NsbmMemberRegister

@{
    ViewData["Title"] = "Create Member";
}

<h1>Create</h1>
<h4>Đăng ký thành viên</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NsbmUserName" class="control-label"></label>
                <input asp-for="NsbmUserName" class="form-control" />
                <span asp-validation-for="NsbmUserName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NsbmPassword" class="control-label"></label>
                <input asp-for="NsbmPassword" class="form-control" type="password" />
                <span asp-validation-for="NsbmPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NsbmEmail" class="control-label"></label>
                <input asp-for="NsbmEmail" class="form-control" />
                <span asp-validation-for="NsbmEmail" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NsbmPhoneNumber" class="control-label"></label>
                <input asp-for="NsbmPhoneNumber" class="form-control" />
                <span asp-validation-for="NsbmPhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}