@model IEnumerable<NguyenSinhBinhMinh_2410900053_exam.Models.NguyenSinhBinhMinhStudent>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Danh sách Sinh viên</h2>

    <p>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            + Create New
        </a>
    </p>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.NguyenSinhBinhMinhName)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenSinhBinhMinhGender)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenSinhBinhMinhBirthday)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenSinhBinhMinhEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenSinhBinhMinhPhone)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenSinhBinhMinhActive)</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.NguyenSinhBinhMinhName)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenSinhBinhMinhGender)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenSinhBinhMinhBirthday)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenSinhBinhMinhEmail)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenSinhBinhMinhPhone)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenSinhBinhMinhActive)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>