@model NsbmLesson7.Models.DataModels.NsbmMember

@{
    ViewData["Title"] = "Create";
}
<div class="card p-3">
<h1>THêm mới thành viên</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" asp-controller="NsbmMember">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NsbmUserName" class="control-label"></label>
                <input asp-for="NsbmUserName" class="form-control" />
                <span asp-validation-for="NsbmUserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NsbmPassword" class="control-label"></label>
                <input asp-for="NsbmPassword" class="form-control" />
                <span asp-validation-for="NsbmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NsbmFullName" class="control-label"></label>
                <input asp-for="NsbmFullName" class="form-control" />
                <span asp-validation-for="NsbmFullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NsbmEmail" class="control-label"></label>
                <input asp-for="NsbmEmail" class="form-control" />
                <span asp-validation-for="NsbmEmail" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>
</div>