<!doctype html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewData["Title"]- Nguyễn Sinh Bình Minh</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css">  
        @RenderSection("Css", required: false)

    </head>
    <body>
        <nav class="navbar navbar-inverse">
            <div class="container">
                <ul class="nav navbar-nav">
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>\
                <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
            </div>
        </nav>
        <div class="container">
            @RenderBody()
        </div>
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <!-- cho phép view riêng lẻ chèn vào đây các đoạn script riêng của view đó -->
    @RenderSection("Scripts", required: false)
    </body>
</html>