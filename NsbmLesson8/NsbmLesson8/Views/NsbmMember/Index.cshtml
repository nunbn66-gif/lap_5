@model IEnumerable<NsbmLesson8.Models.NsbmMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}
<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="NsbmCreate">Them moi</a>
    </div>"


<div class="card-body">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NsbmUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NsbmPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NsbmFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NsbmEmail)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NsbmUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.NsbmPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.NsbmFullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.NsbmEmail)
            </td>
            <td>
                <a asp-action="NsbmEdit" asp-route-id="@item.NsbmMemberId">Edit</a> |
                <a asp-action="NsbmDetails" asp-route-id="@item.NsbmMemberId">Details</a> |
                <a asp-action="NsbmDelete" asp-route-id="@item.NsbmMemberId">Delete</a>
            </td>
        </tr>
        }
    </tbody>
</table>
</div>
</div>